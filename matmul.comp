#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 8, local_size_y = 8) in;
layout(constant_id = 0) const uint DIM = 512;

layout(set = 0, binding = 0) readonly buffer A { float16_t a[]; };
layout(set = 0, binding = 1) readonly buffer B { float16_t b[]; };
layout(set = 0, binding = 2) writeonly buffer C { float16_t c[]; };

void main() {
    uint col = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    if (col >= DIM || row >= DIM) return;
    float acc = 0.0;
    for (uint k = 0u; k < DIM; k++) {
        acc += float(a[row * DIM + k]) * float(b[k * DIM + col]);
    }
    c[row * DIM + col] = float16_t(acc);
}
